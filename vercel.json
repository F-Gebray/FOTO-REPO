{
  "version": 2,
  "functions": {
    "booking-api/index.js": {
      "runtime": "nodejs18.x"
    },
    "landing-page/api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/booking-api/index.js"
    },
    {
      "source": "/landing-api/(.*)",
      "destination": "/landing-page/api/$1"
    },
    {
      "source": "/booking/(.*)",
      "destination": "/booking-app/dist/$1"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/dist/$1"
    },
    {
      "source": "/landing-page/(.*)",
      "destination": "/landing-page/travel-landing-page/dist/$1"
    },
    {
      "source": "/((?!booking|dashboard|landing-page).*)",
      "destination": "/my-app/dist/$1"
    }
  ]
}
