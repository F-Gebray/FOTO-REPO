{
  "rewrites": [
    {
      "source": "/landing-api/(.*)",
      "destination": "/landing-page/api/send-email.js"
    },
    {
      "source": "/landing-page/(.*)",
      "destination": "/landing-page/travel-landing-page/dist/$1"
    },
    {
      "source": "/booking/(.*)",
      "destination": "/booking-app/dist/$1"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/dist/$1"
    },
    {
      "source": "/((?!landing-page|booking|dashboard).*)",
      "destination": "/my-app/dist/$1"
    }
  ]
}
